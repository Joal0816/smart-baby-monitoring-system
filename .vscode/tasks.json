{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start caregiver UI preview (VS Code)",
      "type": "shell",
      "command": "python3",
      "args": ["web/dev-server.py"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "preview",
        "pattern": { "regexp": ".*" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VS Code preview:",
          "endsPattern": "VS Code preview:"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Build Android app (debug APK)",
      "type": "shell",
      "command": "./gradlew",
      "args": ["assembleDebug"],
      "options": { "cwd": "${workspaceFolder}/android" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
